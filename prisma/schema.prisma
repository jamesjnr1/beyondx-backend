generator client {
  provider        = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model Worker {
  id             String       @id @default(uuid())
  workerId       String       @unique
  fullName       String
  pinHash        String
  phone          String?
  prisonFacility String?
  releaseDate    DateTime?
  offenseLevel   OffenseLevel @default(none)
  offenseNotes   String?
  skills         String[]
  bio            String?
  dailyCharge    Decimal      @default(80)
  rating         Decimal      @default(0)
  tasksCompleted Int          @default(0)
  totalEarned    Decimal      @default(0)
  isActive       Boolean      @default(true)
  gpsVerified    Boolean      @default(false)
  idVerified        Boolean   @default(false)
  idVerificationRef String?
  idType            String?
  idCardNumber      String?
  guarantorName         String?
  guarantorPhone        String?
  guarantorRelationship String?
  lastActiveAt          DateTime? @default(now())
  photoUrl              String?
  homeArea              String?    // neighbourhood/area, e.g. "Madina, Accra"
  homeLat               Float?     // approximate, from area lookup or GPS
  homeLng               Float?
  createdAt      DateTime     @default(now())
  dispatches     Dispatch[]
  ussdSessions   UssdSession[]
  tasks Task[]
  reviewsReceived Review[] @relation("ReviewsOfWorker")
}

model Employer {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  orgName       String
  contactPerson String?
  phone         String?
  address       String?
  region        String?
  isVerified    Boolean    @default(false)
  logoUrl       String?
  acknowledgedAt DateTime?
  rating        Decimal    @default(0)
  createdAt     DateTime   @default(now())
  dispatches    Dispatch[]
  payments      Payment[]
  tasks      Task[]
  reviewsReceived Review[] @relation("ReviewsOfEmployer")
}

model Dispatch {
  id              String         @id @default(uuid())
  reference       String         @unique
  worker          Worker         @relation(fields: [workerId], references: [id])
  workerId        String
  employer        Employer       @relation(fields: [employerId], references: [id])
  employerId      String
  taskType        String
  taskDescription String?
  location        String?
  startDate       DateTime
  durationDays    Decimal
  workerRate      Decimal
  platformFee     Decimal
  totalAmount     Decimal
  status          DispatchStatus @default(pending_payment)
  payment         Payment?
  createdAt       DateTime       @default(now())
}

model Payment {
  id          String    @id @default(uuid())
  paystackRef String    @unique
  employer    Employer  @relation(fields: [employerId], references: [id])
  employerId  String
  dispatch    Dispatch  @relation(fields: [dispatchId], references: [id])
  dispatchId  String    @unique
  amount      Decimal
  currency    String    @default("GHS")
  method      PayMethod
  status      PayStatus @default(pending)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
}

model UssdSession {
  sessionId String   @id
  msisdn    String
  worker    Worker?  @relation(fields: [workerId], references: [id])
  workerId  String?
  step      String   @default("main")
  data      Json     @default("{}")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Task {
  id             String     @id @default(uuid())
  employer       Employer   @relation(fields: [employerId], references: [id])
  employerId     String
  taskType       String
  description    String?
  paymentRef     String?
  location       String
  duration       String
  pay            Decimal
  status         TaskStatus @default(open)
  adminNote      String?
  createdAt      DateTime   @default(now())
  acceptedBy     Worker?    @relation(fields: [workerId], references: [id])
  workerId       String?
  reviews        Review[]
  // Multi-worker slots: when a job needs more than one person, several Task
  // rows share the same groupId — one per candidate worker offered the job.
  // slotsNeeded is copied onto every row in the group so any single row can
  // tell how many total slots the posting needs without a second query.
  groupId        String?
  slotsNeeded    Int?
  filledSlots    Int       @default(0)  // tracks how many workers accepted so far
  // Offer expiry: set when a task is dispatched with a time limit. Checked
  // lazily on read (see expireStaleOffers in routes/tasks.js) rather than
  // via a cron job, since Railway has none configured for this project.
  offerExpiresAt DateTime?
  // Transport allowance — added to employer total when worker lives far from
  // the job location. The worker receives this on top of their full pay.
  transportAllowance Int?    @default(0)
  scheduledDate  String?    // e.g. "2026-08-20" — the day the job starts
  scheduledTime  String?    // e.g. "08:00" — time worker should arrive
  reminderSentAt DateTime?  // set once the 1-hour-before reminder SMS fires

  @@index([groupId])
}

// A review left on a task, in one direction only: either the worker
// reviewing the employer, or the employer reviewing the worker. Both
// directions can exist for the same task (one each), but not two of the
// same direction — enforced by the unique constraint below.
model Review {
  id          String       @id @default(uuid())
  task        Task         @relation(fields: [taskId], references: [id])
  taskId      String
  fromRole    ReviewerRole
  rating      Int
  comment     String?
  worker      Worker?      @relation("ReviewsOfWorker", fields: [workerId], references: [id])
  workerId    String?
  employer    Employer?    @relation("ReviewsOfEmployer", fields: [employerId], references: [id])
  employerId  String?
  createdAt   DateTime     @default(now())

  @@unique([taskId, fromRole])
}

enum ReviewerRole {
  worker
  employer
}

enum TaskStatus {
  open
  payment_pending
  offered
  accepted
  pending_confirmation
  employer_confirmed
  completed
  payment_rejected
  cancelled
  expired
}

enum OffenseLevel {
  none
  minor
  major
}

enum DispatchStatus {
  pending_payment
  confirmed
  active
  completed
  cancelled
}

enum PayMethod {
  mtn_momo
  voda_cash
  airteltigo
  bank_card
}

enum PayStatus {
  pending
  success
  failed
  reversed
}

// Phone OTP verification — one row per phone number being verified.
// Stored on Railway instead of Supabase so we don't need a separate
// SUPABASE_SERVICE_KEY env var on Vercel. Primary key is phone so an
// upsert naturally replaces any previous code for the same number.
model PhoneOtp {
  phone     String   @id
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Leads captured at events (market days, expos, etc.) — separate from real
// Worker/Employer accounts since these are just interested people who gave
// their contact info at a stand, not registered users yet. Staff follow up
// afterward by phone/SMS to actually convert them.
model Lead {
  id         String   @id @default(uuid())
  name       String
  phone      String
  interest   String   // 'worker' | 'employer' | 'curious'
  category   String?  // skill category, only relevant if interest === 'worker'
  location   String?
  notes      String?
  source     String   @default("market_day")
  followedUp Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([followedUp])
}

model SmsLog {
  id          String   @id @default(uuid())
  phone       String
  message     String
  status      String   // 'sent' | 'failed'
  errorType   String?  // 'low_balance' | 'other' | null
  errorDetail String?
  createdAt   DateTime @default(now())
}

// Self-hosted visitor tracking — replaces Vercel Analytics for the specific
// question of "how many people look at the site vs actually register."
// One row per anonymous visitor (identified by a client-generated UUID
// stored in localStorage), upserted on every visit. When that same visitor
// later registers as a worker or employer, the registration route links
// back here so we can compute a real visit -> signup conversion rate,
// not just separate visitor and signup counts.
model Visitor {
  id          String    @id @default(uuid())
  visitorId   String    @unique
  firstPath   String?
  referrer    String?
  userAgent   String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  pageViews   Int       @default(1)
  convertedAt DateTime?
  convertedAs String?   // 'worker' | 'employer'

  @@index([firstSeenAt])
  @@index([convertedAt])
}
